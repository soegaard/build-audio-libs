+/*
+ * The upstream path is an absolute configure-time path. That does not work
+ * after a package is moved. On macOS, derive the path from libao itself.
+ * Other systems keep the normal configured path and are made relocatable by
+ * the staging RPATH rules.
+ */
+static const char *_ao_runtime_path(int plugin_directory)
+{
+#ifdef __APPLE__
+        static char library_path[PATH_MAX];
+        static char plugin_path[PATH_MAX];
+        Dl_info image;
+        char *slash;
+
+        if (dladdr((const void *)&ao_initialize, &image) != 0 && image.dli_fname) {
+                snprintf(library_path, sizeof(library_path), "%s", image.dli_fname);
+                slash = strrchr(library_path, '/');
+                if (slash != NULL) {
+                        *slash = '\0';
+                        snprintf(plugin_path, sizeof(plugin_path), "%s/ao/plugins-4",
+                                 library_path);
+                        return plugin_directory ? plugin_path : library_path;
+                }
+        }
+#endif
+        return AO_PLUGIN_PATH;
+}
+
+/* Racket flattens copy-foreign-libs into its foreign-library directory.
+ * Keep that install mode working without treating unrelated libraries as
+ * plugins. The normal archive layout is still lib/ao/plugins-4. */
+static int _ao_plugin_filename(const char *filename)
+{
+        static const char *names[] = {
+                "libalsa", "libarts", "libesd", "libirix", "libmacosx",
+                "libnas", "liboss", "libpulse", "libroar", "libsndio",
+                "libsun", NULL
+        };
+        int i;
+        for (i = 0; names[i] != NULL; i++)
+                if (strncmp(filename, names[i], strlen(names[i])) == 0)
+                        return 1;
+        return 0;
+}
 
