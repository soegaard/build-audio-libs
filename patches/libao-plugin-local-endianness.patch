+/* A dynamic plug-in cannot rely on symbols from the library that loaded it.
+   Keep this small byte-order check inside the plug-in. */
+static int ao_macosx_is_big_endian(void)
+{
+  const unsigned short pattern = 0xbabe;
+
+  return ((const unsigned char *)&pattern)[0] == 0xba;
+}
